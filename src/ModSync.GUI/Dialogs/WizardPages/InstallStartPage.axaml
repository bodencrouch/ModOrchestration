<UserControl
    x:Class="ModSync.Dialogs.WizardPages.InstallStartPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="16,12" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
        <TextBlock x:Name="HeaderText" Grid.Row="0" Margin="0,0,0,8" Text="Ready to Begin Installation" />
        <TextBlock Grid.Row="1" Margin="0,0,0,12" Text="Review your mod selection and environment readiness below. Click 'Next' to begin installation." TextWrapping="Wrap" />

        <Border Grid.Row="2" Margin="0,0,0,12" MinHeight="48" Padding="12" CornerRadius="8">
            <StackPanel Spacing="6">
                <TextBlock Text="Environment readiness" />
                <TextBlock x:Name="ReadinessStatusText" Text="Checking environment..." TextWrapping="Wrap" />
                <TextBlock x:Name="ReadinessDetailText" TextWrapping="Wrap" Opacity="0.9" IsVisible="False" />
                <TextBlock x:Name="ReadinessHintText"
                           Text="For full validation detail (conflicts, dry-run, archives), go back to the Validate step."
                           TextWrapping="Wrap"
                           Opacity="0.75" />
            </StackPanel>
        </Border>

        <Border
            x:Name="ResumeOfferPanel"
            Grid.Row="3"
            Margin="0,0,0,12"
            Padding="12"
            CornerRadius="8"
            IsVisible="False">
            <StackPanel Spacing="8">
                <TextBlock Text="Previous install session found" />
                <TextBlock
                    x:Name="ResumeOfferDetailText"
                    TextWrapping="Wrap"
                    Opacity="0.9" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="ResumePreviousButton" Content="Resume previous install" />
                    <Button x:Name="StartOverButton" Content="Start over" />
                </StackPanel>
                <TextBlock
                    x:Name="ResumeChoiceStatusText"
                    Opacity="0.8"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="4" MinHeight="120" Padding="12" CornerRadius="8">
            <Grid RowDefinitions="Auto,*">
                <TextBlock x:Name="SelectedModsText" Grid.Row="0" Margin="0,0,0,8" />
                <ScrollViewer x:Name="ModListScrollViewer" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ModListPanel" Spacing="4" />
                </ScrollViewer>
            </Grid>
        </Border>
        <Border Grid.Row="5" Margin="0,12,0,0" Padding="12" CornerRadius="4">
            <StackPanel Spacing="6">
                <TextBlock Text="Important" />
                <StackPanel Spacing="2">
                    <TextBlock Text="• Mid-install failures can usually resume from the last completed mod when session state is intact" />
                    <TextBlock Text="• Git checkpoints are optional restore points — they are not a one-click undo of the whole game folder" />
                    <TextBlock Text="• Do not close the application during installation" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
