<UserControl
    x:Class="ModSync.Dialogs.WizardPages.InstallingPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer x:Name="PageScrollViewer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Grid Margin="16,12" RowDefinitions="Auto,*,Auto,Auto">
        <!--  Main Progress Section  -->
        <Border Grid.Row="0" Padding="24,20" CornerRadius="12" Margin="0,0,0,16">
            <StackPanel Spacing="16">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock
                        x:Name="PercentText"
                        Grid.Column="0"
                        Text="0%" />
                    <TextBlock
                        x:Name="CountText"
                        Grid.Column="1"
                        Opacity="0.8"
                        VerticalAlignment="Center"
                        Text="0/0 mods installed" />
                </Grid>

                <ProgressBar
                    x:Name="MainProgressBar"
                    Height="12"
                    Maximum="1"
                    Minimum="0"
                    CornerRadius="6" />

                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="6">
                        <TextBlock
                            x:Name="CurrentModText"
                            Text="Preparing installation..." />
                        <TextBlock
                            x:Name="DirectionsText"
                            MaxHeight="60"
                            Opacity="0.7"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="RunStateText"
                            Opacity="0.85"
                            Text="Status: starting"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock
                        x:Name="CurrentOperationText"
                        Grid.Column="1"
                        Opacity="0.6"
                        VerticalAlignment="Top"
                        Text="Initializing..." />
                </Grid>

                <ProgressBar
                    x:Name="CurrentModProgress"
                    Height="6"
                    IsIndeterminate="True"
                    CornerRadius="3" />

                <Grid ColumnDefinitions="Auto,*" Margin="0,8,0,0">
                    <TextBlock
                        Grid.Column="0"
                        Opacity="0.7"
                        Text="💾 " />
                    <TextBlock
                        x:Name="CheckpointStatusText"
                        Grid.Column="1"
                        Opacity="0.7"
                        Text="Checkpoints enabled" />
                </Grid>
            </StackPanel>
        </Border>

        <!--  Statistics & Info Grid  -->
        <Grid Grid.Row="1" ColumnDefinitions="*,16,*" RowDefinitions="Auto,16,Auto">
            <Border
                Grid.Row="0"
                Grid.Column="0"
                Padding="20,16"
                CornerRadius="10">
                <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,12,Auto,12,Auto">
                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                        <TextBlock Opacity="0.6" Text="ELAPSED" TextAlignment="Center" />
                        <TextBlock
                            x:Name="ElapsedTimeText"
                            Text="--:--:--"
                            TextAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                        <TextBlock Opacity="0.6" Text="REMAINING" TextAlignment="Center" />
                        <TextBlock
                            x:Name="RemainingTimeText"
                            Text="--:--:--"
                            TextAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4">
                        <TextBlock Opacity="0.6" Text="RATE" TextAlignment="Center" />
                        <TextBlock
                            x:Name="RateText"
                            Text="0.0/min"
                            TextAlignment="Center" />
                    </StackPanel>

                    <StackPanel
                        Grid.Row="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Spacing="4">
                        <TextBlock Opacity="0.6" Text="ISSUES" TextAlignment="Center" />
                        <Grid ColumnDefinitions="*,*">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                                <TextBlock Text="⚠️" />
                                <TextBlock x:Name="WarningsText" Text="0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                                <TextBlock Text="❌" />
                                <TextBlock x:Name="ErrorsText" Text="0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel
                        Grid.Row="4"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Spacing="4">
                        <TextBlock Opacity="0.6" Text="CHECKPOINTS CREATED" TextAlignment="Center" />
                        <TextBlock
                            x:Name="CheckpointsCreatedText"
                            Text="0"
                            TextAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border
                Grid.Row="0"
                Grid.Column="2"
                Padding="20,16"
                CornerRadius="10">
                <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="🎮" TextAlignment="Center" />
                    <TextBlock Text="Installing Your Mods" TextAlignment="Center" />
                    <TextBlock
                        Opacity="0.7"
                        Text="Sit back and relax while we handle everything"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border
                Grid.Row="2"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Padding="20,16"
                CornerRadius="10">
                <StackPanel Spacing="8">
                    <TextBlock Text="⚙️ What's Happening?" />
                    <Grid ColumnDefinitions="*,*">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Opacity="0.8" Text="✓ Extracting archives" />
                            <TextBlock Opacity="0.8" Text="✓ Running TSLPatcher/HoloPatcher" />
                            <TextBlock Opacity="0.8" Text="✓ Moving and copying files" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Opacity="0.8" Text="✓ Managing dependencies" />
                            <TextBlock Opacity="0.8" Text="✓ Creating checkpoints" />
                            <TextBlock Opacity="0.8" Text="✓ Validating installations" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!--  Failure / resume panel  -->
        <Border
            x:Name="FailurePanel"
            Grid.Row="2"
            Margin="0,16,0,0"
            Padding="16,12"
            CornerRadius="8"
            IsVisible="False">
            <StackPanel Spacing="8">
                <TextBlock x:Name="FailureSummaryText" TextWrapping="Wrap" />
                <TextBlock
                    x:Name="ResumeHintText"
                    Opacity="0.85"
                    Text="Resume continues remaining mods from session state. This does not undo completed work or restore a pristine game folder."
                    TextWrapping="Wrap" />
                <Button
                    x:Name="ResumeRetryButton"
                    HorizontalAlignment="Left"
                    Content="Resume / Retry"
                    IsVisible="False" />
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Padding="16,12" CornerRadius="8" Margin="0,16,0,0">
            <TextBlock
                Opacity="0.7"
                Text="⚠️ Please do not close the application during installation"
                TextAlignment="Center" />
        </Border>
    </Grid>
    </ScrollViewer>
</UserControl>
